{
  "name": "@ngrok/app-server",
  "version": "0.2.0",
  "description": "A composable Hono app server for React Router and TanStack Start: prerendered pages, streamed compression, structured logs, and clean shutdown on Node, Bun, and Deno.",
  "homepage": "https://github.com/ngrok/app-server#readme",
  "bugs": {
    "url": "https://github.com/ngrok/app-server/issues"
  },
  "license": "MIT",
  "author": "ngrok",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngrok/app-server"
  },
  "bin": {
    "app-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./node/vite": {
      "types": "./dist/node-vite.d.ts",
      "import": "./dist/node-vite.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js"
    },
    "./react-router/vite": {
      "types": "./dist/react-router-vite.d.ts",
      "import": "./dist/react-router-vite.js"
    },
    "./tanstack-start": {
      "types": "./dist/tanstack-start.d.ts",
      "import": "./dist/tanstack-start.js"
    },
    "./tanstack-start/vite": {
      "types": "./dist/tanstack-start-vite.d.ts",
      "import": "./dist/tanstack-start-vite.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:runtimes": "node ./test/runtimes.ts",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@react-router/dev": "8.5.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.0",
    "react-router": "^8.5.0",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
