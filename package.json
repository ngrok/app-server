{
  "name": "@ngrok/app-server",
  "version": "0.0.0",
  "description": "A composable Hono app server for React Router: prerendered pages, streamed compression, structured logs, and clean shutdown on Node, Bun, and Deno.",
  "homepage": "https://github.com/ngrok/mantle/tree/main/packages/app-server#readme",
  "license": "MIT",
  "author": "ngrok",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngrok/mantle",
    "directory": "packages/app-server"
  },
  "bin": {
    "app-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@ngrok/src-live-types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "@ngrok/src-live-types": "./src/react-router.ts",
      "import": "./dist/react-router.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "@ngrok/src-live-types": "./src/vite.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/clean-publish-manifest.js clean",
    "postpack": "node ../../scripts/clean-publish-manifest.js restore",
    "test": "vitest run",
    "test:runtimes": "node ./test/runtimes.ts",
    "test:watch": "vitest watch",
    "typecheck": "tsrs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@cfg/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "react-router": "8.5.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react-router": "^8.5.0",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.0.0"
  }
}
